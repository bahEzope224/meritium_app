#!/bin/bash

# =====================================================
# SCRIPT DE CRÉATION DE L'ARBORESCENCE MERITIUM
# =====================================================

echo "🚀 Création de l'arborescence Meritium..."

# Couleurs pour les messages
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# =====================================================
# ÉTAPE 1 : CRÉER LA STRUCTURE FRONTEND
# =====================================================

echo -e "${BLUE}📁 Création de la structure Frontend...${NC}"

# Dossiers principaux
mkdir -p src/components
mkdir -p src/pages
mkdir -p src/auth
mkdir -p src/api
mkdir -p src/utils
mkdir -p public

# Fichiers components
touch src/components/Buttons.jsx
touch src/components/Inputs.jsx
touch src/components/Cards.jsx
touch src/components/Navbar.jsx

# Fichiers pages
touch src/pages/HomePage.jsx
touch src/pages/LoginPage.jsx
touch src/pages/SignupPage.jsx
touch src/pages/CandidateDashboard.jsx
touch src/pages/CompanyDashboard.jsx
touch src/pages/MessagingPage.jsx
touch src/pages/Dashboard.jsx

# Fichiers auth
touch src/auth/AuthContext.jsx

# Fichiers API
touch src/api/axios.js
touch src/api/auth.js
touch src/api/profiles.js
touch src/api/messages.js

# Fichiers utils
touch src/utils/constants.js
touch src/utils/helpers.js

# Fichiers racine src
touch src/App.jsx
touch src/main.jsx
touch src/index.css

echo -e "${GREEN}✅ Structure Frontend créée${NC}"

# =====================================================
# ÉTAPE 2 : CRÉER LA STRUCTURE BACKEND
# =====================================================

echo -e "${BLUE}📁 Création de la structure Backend...${NC}"

# Dossiers backend
mkdir -p backend/routes
mkdir -p backend/middleware
mkdir -p backend/controllers
mkdir -p backend/models
mkdir -p backend/config
mkdir -p backend/utils

# Fichiers routes
touch backend/routes/auth.js
touch backend/routes/profiles.js
touch backend/routes/messages.js
touch backend/routes/interests.js

# Fichiers middleware
touch backend/middleware/auth.js
touch backend/middleware/errorHandler.js
touch backend/middleware/validator.js

# Fichiers controllers
touch backend/controllers/authController.js
touch backend/controllers/profileController.js
touch backend/controllers/messageController.js

# Fichiers models
touch backend/models/User.js
touch backend/models/Profile.js
touch backend/models/Message.js

# Fichiers config
touch backend/config/db.js
touch backend/config/jwt.js

# Fichiers utils
touch backend/utils/validation.js
touch backend/utils/errorMessages.js

# Fichiers racine backend
touch backend/server.js
touch backend/.env
touch backend/.env.example
touch backend/.gitignore
touch backend/package.json

# Fichier SQL
touch backend/database.sql

echo -e "${GREEN}✅ Structure Backend créée${NC}"

# =====================================================
# ÉTAPE 3 : CRÉER LES FICHIERS DE CONFIGURATION
# =====================================================

echo -e "${BLUE}📁 Création des fichiers de configuration...${NC}"

# Fichiers racine projet
touch .gitignore
touch .env
touch .env.example
touch README.md
touch package.json
touch vite.config.js
touch tailwind.config.js
touch postcss.config.js
touch index.html

# Dossier docs
mkdir -p docs
touch docs/API.md
touch docs/SETUP.md
touch docs/ARCHITECTURE.md

echo -e "${GREEN}✅ Fichiers de configuration créés${NC}"

# =====================================================
# ÉTAPE 4 : CRÉER LE .gitignore RACINE
# =====================================================

echo -e "${BLUE}📝 Création du .gitignore...${NC}"

cat > .gitignore << 'EOF'
# Dependencies
node_modules/
backend/node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# Build outputs
dist/
build/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Misc
*.pem
EOF

echo -e "${GREEN}✅ .gitignore créé${NC}"

# =====================================================
# ÉTAPE 5 : CRÉER LE .gitignore BACKEND
# =====================================================

cat > backend/.gitignore << 'EOF'
node_modules/
.env
*.log
dist/
EOF

# =====================================================
# ÉTAPE 6 : CRÉER LE README.md
# =====================================================

echo -e "${BLUE}📝 Création du README.md...${NC}"

cat > README.md << 'EOF'
# �� Meritium - Plateforme de Recrutement Équitable

## Description
Meritium est une plateforme de recrutement qui élimine les biais discriminatoires en anonymisant les candidatures. Seules les compétences et qualifications sont visibles jusqu'à validation mutuelle.

## 🚀 Installation

### Prérequis
- Node.js 18+
- PostgreSQL 14+
- npm ou yarn

### Frontend
```bash
